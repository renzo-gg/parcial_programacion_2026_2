@model IncidenciasViewModel
@{
    ViewData["Title"] = "Incidencias";
}

<h1>Incidencias abiertas en tiempo real</h1>

<p id="estado-conexion" class="text-muted small">Conectando al canal de tiempo real…</p>

<form asp-controller="Operaciones" asp-action="Incidencias" method="get" class="mb-3" id="form-busqueda">
    <div class="input-group">
        <input type="search" name="q" id="q" value="@Model.TextoBusqueda" class="form-control"
               placeholder="Buscar por estacion o descripcion" aria-label="Buscar por estacion o descripcion" />
        <button type="submit" class="btn btn-primary">Buscar</button>
        @if (Model.HayBusqueda)
        {
            <a asp-controller="Operaciones" asp-action="Incidencias" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

@if (Model.HayBusqueda)
{
    <p id="resumen-busqueda">
        @Model.Incidencias.Count coincidencia(s) para <strong>@Model.TextoBusqueda</strong>.
        Solo se muestran incidencias abiertas existentes en la base de datos.
    </p>
}

@if (Model.Incidencias.Count == 0)
{
    <p id="sin-resultados">No hay incidencias abiertas para mostrar.</p>
}
else
{
    <table class="table table-striped" id="tabla-incidencias">
        <thead>
            <tr>
                <th>Id</th>
                <th>Estacion</th>
                <th>Descripcion</th>
                <th>Fecha apertura</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var incidencia in Model.Incidencias)
            {
                <tr data-incidencia-id="@incidencia.Id">
                    <td>@incidencia.Id</td>
                    <td>@incidencia.Estacion</td>
                    <td>@incidencia.Descripcion</td>
                    <td>@incidencia.FechaApertura.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@incidencia.Estado</td>
                    <td>
                        <form asp-controller="Operaciones" asp-action="Cerrar" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@incidencia.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        (function () {
            const estadoConexion = document.getElementById('estado-conexion');
            const conexion = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/incidencias')
                .withAutomaticReconnect()
                .build();

            conexion.on('IncidenciaActualizada', function (dto) {
                const fila = document.querySelector('tr[data-incidencia-id="' + dto.Id + '"]');

                if (fila && dto.Estado === 'Cerrada') {
                    fila.remove();
                }

                const restantes = document.querySelectorAll('#tabla-incidencias tbody tr').length;
                let vacio = document.getElementById('sin-resultados');
                const cuerpo = document.querySelector('#tabla-incidencias tbody');

                if (restantes === 0 && cuerpo) {
                    if (!vacio) {
                        vacio = document.createElement('p');
                        vacio.id = 'sin-resultados';
                        vacio.textContent = 'No hay incidencias abiertas para mostrar.';
                        cuerpo.closest('.container').querySelector('#tabla-incidencias')
                            .parentNode.insertBefore(vacio, document.getElementById('tabla-incidencias'));
                    }
                }
            });

            conexion.onreconnecting(function () {
                estadoConexion.textContent = 'Reconectando al canal de tiempo real…';
            });

            conexion.onreconnected(function () {
                estadoConexion.textContent = 'Conectado al canal de tiempo real';
            });

            conexion.onclose(function () {
                estadoConexion.textContent = 'Canal de tiempo real desconectado';
            });

            conexion.start()
                .then(function () {
                    estadoConexion.textContent = 'Conectado al canal de tiempo real';
                    return conexion.invoke('Suscribir');
                })
                .catch(function (error) {
                    estadoConexion.textContent = 'No se pudo conectar al canal de tiempo real';
                    console.error(error);
                });
        })();
    </script>
}
