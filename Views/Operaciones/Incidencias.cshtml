@model IncidenciasViewModel
@{
    ViewData["Title"] = "Incidencias";
}

<h1>Incidencias abiertas con consulta rápida</h1>

<form asp-controller="Operaciones" asp-action="Incidencias" method="get" class="mb-3" id="form-busqueda">
    <div class="input-group">
        <input type="search" name="q" id="q" value="@Model.TextoBusqueda" class="form-control"
               placeholder="Buscar por estacion o descripcion" aria-label="Buscar por estacion o descripcion" />
        <button type="submit" class="btn btn-primary">Buscar</button>
        @if (Model.HayBusqueda)
        {
            <a asp-controller="Operaciones" asp-action="Incidencias" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

@if (Model.HayBusqueda)
{
    <p id="resumen-busqueda">
        @Model.Incidencias.Count coincidencia(s) para <strong>@Model.TextoBusqueda</strong>.
        Solo se muestran incidencias abiertas existentes en la base de datos.
    </p>
}

@if (Model.Incidencias.Count == 0)
{
    <p id="sin-resultados">No hay incidencias abiertas para mostrar.</p>
}
else
{
    <table class="table table-striped" id="tabla-incidencias">
        <thead>
            <tr>
                <th>Id</th>
                <th>Estacion</th>
                <th>Descripcion</th>
                <th>Fecha apertura</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var incidencia in Model.Incidencias)
            {
                <tr data-incidencia-id="@incidencia.Id">
                    <td>@incidencia.Id</td>
                    <td>@incidencia.Estacion</td>
                    <td>@incidencia.Descripcion</td>
                    <td>@incidencia.FechaApertura.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@incidencia.Estado</td>
                    <td>
                        <form asp-controller="Operaciones" asp-action="Cerrar" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@incidencia.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
