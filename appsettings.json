  // La cadena de Redis se define como VARIABLE DE ENTORNO en Render, o en local:
  //
  //   $env:REDIS_CONNECTION = "quince-ochre-horses-71782.db.redis.io:10647,password=<CLAVE>,ssl=false,abortConnect=false"
  //
  // Claves aceptadas, en orden de precedencia:
  //   Redis:ConnectionString  |  RedisConnectionString  |  ConnectionStrings:Redis
  //   REDIS_CONNECTION  |  REDIS_URL
  "Redis": {
    "ConnectionString": ""
  }
}
